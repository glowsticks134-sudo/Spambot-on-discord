# Discord bot token. Store this as a Replit Secret named TOKEN.
TOKEN=

# Use a server ID for fast slash-command registration during development.
# Leave blank to register the command globally.
GUILD_ID=

# Your Discord account ID. This authorizes you to use /dm directly in a DM
# with the bot and receives a copy of every message sent through the bot.
OWNER_ID=

# Prefix for the legacy text command, for example !dm.
PREFIX=!